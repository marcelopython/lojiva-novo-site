---
import { formatBRL, type Plan } from '@/data/plans';
import Button from './Button.astro';

type Props = { plan: Plan };
const { plan } = Astro.props;
---

<div class={`relative flex flex-col rounded-2xl border bg-card p-6 shadow-soft ${plan.destaque ? 'border-primary ring-2 ring-primary/25' : 'border-border'}`}>
  {plan.destaque && (
    <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground">
      Mais popular
    </span>
  )}
  <h3 class="font-display text-lg font-bold text-foreground">{plan.nome}</h3>
  <div class="mt-3 flex items-baseline gap-1">
    <span class="font-display text-2xl font-bold text-foreground">{formatBRL(plan.precoCentavos)}</span>
    <span class="text-sm text-muted-foreground">/mês</span>
  </div>
  <ul class="mt-4 space-y-1.5 text-xs text-muted-foreground">
    <li>{plan.limites.usuarios} {plan.limites.usuarios === 1 ? 'usuário' : 'usuários'}</li>
    <li>{plan.limites.locaisDeEstoque} {plan.limites.locaisDeEstoque === 1 ? 'local de estoque' : 'locais de estoque'}</li>
    <li>{plan.limites.integracoes === 0 ? 'Sem integrações' : `${plan.limites.integracoes} integrações`}</li>
  </ul>
  <ul class="mt-4 space-y-2 border-t border-border pt-4 text-sm text-foreground/85">
    {plan.funcionalidades.map((f) => (
      <li class="flex items-start gap-2">
        <span class="mt-1 text-success" aria-hidden="true">✓</span>
        <span>{f}</span>
      </li>
    ))}
  </ul>
  <Button href={`/cadastro?plan_id=${plan.planId}`} variant={plan.destaque ? 'primary' : 'outline'} class="mt-6">
    Começar agora
  </Button>
</div>
