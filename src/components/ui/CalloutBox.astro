---
type Props = {
  variant?: 'info' | 'warning';
  title?: string;
};
const { variant = 'info', title } = Astro.props;

const styles: Record<string, string> = {
  info: 'border-primary/30 bg-accent',
  warning: 'border-warning/30 bg-warning/10',
};
---

<div class={`my-6 rounded-xl border p-5 ${styles[variant]}`}>
  {title && <p class="mb-1.5 font-semibold text-foreground">{title}</p>}
  <div class="text-sm text-foreground/80 [&_p]:mb-2 [&_p:last-child]:mb-0">
    <slot />
  </div>
</div>
