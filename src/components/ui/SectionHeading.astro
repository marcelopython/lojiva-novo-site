---
type Props = {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  level?: 1 | 2;
};
const { eyebrow, title, description, align = 'center', level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<div class={`mx-auto max-w-2xl ${align === 'center' ? 'text-center' : 'text-left'}`}>
  {eyebrow && (
    <span class="inline-flex items-center rounded-full bg-accent px-3 py-1 text-xs font-semibold uppercase tracking-wider text-accent-foreground">
      {eyebrow}
    </span>
  )}
  <Heading class="mt-4 font-display text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{title}</Heading>
  {description && <p class="mt-4 text-lg text-muted-foreground">{description}</p>}
</div>
