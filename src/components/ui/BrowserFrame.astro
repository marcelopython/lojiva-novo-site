---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

type Props = {
  src: ImageMetadata;
  alt: string;
  title?: string;
  class?: string;
  priority?: boolean;
};
const { src, alt, title = 'adm.lojiva.com.br', class: className = '', priority = false } = Astro.props;
---

<div class={`overflow-hidden rounded-2xl border border-border bg-surface-dark shadow-elegant ${className}`}>
  <div class="flex items-center gap-2 border-b border-white/10 bg-surface-dark px-4 py-3">
    <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
    <span class="ml-3 rounded-md bg-white/10 px-3 py-1 text-xs text-white/60">{title}</span>
  </div>
  <Image src={src} alt={alt} class="w-full" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 640px, 100vw" />
</div>
