---
// GA4 e Meta Pixel reaproveitados do site institucional atual (Lojiva-site/index.html),
// com a inconsistência original corrigida (o script antigo carregava G-ED5Q58KZ6T mas
// configurava G-56B54VSZHJ — aqui os dois usam o mesmo ID).
const GA4_ID = 'G-56B54VSZHJ';
const META_PIXEL_ID = '1656343855281940';
const CLARITY_ID = 'xiphgefdec';
---

<script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
<script is:inline define:vars={{ GA4_ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag('js', new Date());
  gtag('config', GA4_ID);
  window.gtag = gtag;
</script>

<script is:inline define:vars={{ META_PIXEL_ID }}>
  !(function (f, b, e, v, n, t, s) {
    if (f.fbq) return;
    n = f.fbq = function () {
      n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
    };
    if (!f._fbq) f._fbq = n;
    n.push = n;
    n.loaded = !0;
    n.version = '2.0';
    n.queue = [];
    t = b.createElement(e);
    t.async = !0;
    t.src = v;
    s = b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t, s);
  })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', META_PIXEL_ID);
  fbq('track', 'PageView');
</script>

<script is:inline define:vars={{ CLARITY_ID }}>
  (function (c, l, a, r, i, t, y) {
    c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
    t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
    y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
  })(window, document, 'clarity', 'script', CLARITY_ID);
</script>

<script is:inline>
  // O GA4 registra a origem padrão; este evento separa visitas vindas de assistentes de IA.
  try {
    const referrerHost = new URL(document.referrer).hostname;
    if (['chatgpt.com', 'perplexity.ai', 'gemini.google.com', 'copilot.microsoft.com'].includes(referrerHost)) {
      window.gtag?.('event', 'ai_referral', { ai_source: referrerHost });
    }
  } catch {
    // Acesso direto não tem referrer.
  }
  // Helpers de evento reaproveitáveis por qualquer CTA/formulário do site.
  window.lojivaTrack = {
    ctaClick(label) {
      window.gtag?.('event', 'cta_click', { cta_label: label });
      window.fbq?.('trackCustom', 'CTAClick', { label });
    },
    signupStart() {
      window.gtag?.('event', 'sign_up_start');
      window.fbq?.('track', 'InitiateCheckout');
    },
    leadSubmit() {
      window.gtag?.('event', 'generate_lead');
      window.fbq?.('track', 'Lead');
    },
    whatsappClick() {
      window.gtag?.('event', 'whatsapp_click');
      window.fbq?.('trackCustom', 'WhatsAppClick');
    },
  };
</script>
