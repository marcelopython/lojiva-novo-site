---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { whatsappUrl } from '@/data/plans';

const breadcrumbs = [
  { name: 'Início', url: '/' },
  { name: 'Política de privacidade', url: '/privacidade' },
];
---

<BaseLayout title="Política de privacidade" description="Política de privacidade da Lojiva." noindex>
  <Breadcrumbs items={breadcrumbs} />
  <section class="container-page mx-auto max-w-2xl pb-20 pt-4">
    <h1 class="font-display text-3xl font-bold text-foreground">Política de privacidade</h1>
    <p class="mt-4 text-muted-foreground">
      Esta página está em elaboração pela equipe jurídica da Lojiva. Para dúvidas sobre tratamento de dados pessoais,
      fale diretamente com a nossa equipe.
    </p>
    <p class="mt-4 text-sm text-muted-foreground">
      Contato: <a href={whatsappUrl('Olá! Tenho uma dúvida sobre a política de privacidade da Lojiva.')} class="text-primary underline">WhatsApp da Lojiva</a>
    </p>
  </section>
</BaseLayout>
