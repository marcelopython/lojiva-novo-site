---
import { getCollection, render } from 'astro:content';
import ContentLayout from '@/layouts/ContentLayout.astro';
import { buildRelatedGroups } from '@/lib/related';

export async function getStaticPaths() {
  const entries = await getCollection('comparar');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedGroups = await buildRelatedGroups(entry.data);

const breadcrumbs = [
  { name: 'Início', url: '/' },
  { name: 'Comparações', url: '/comparar' },
  { name: entry.data.title, url: `/comparar/${entry.id}` },
];
---

<ContentLayout
  kicker="Comparação"
  title={entry.data.title}
  description={entry.data.description}
  breadcrumbs={breadcrumbs}
  updatedAt={entry.data.updatedAt}
  publishedAt={entry.data.publishedAt}
  faq={entry.data.faq}
  relatedGroups={relatedGroups}
  isArticle
>
  <Content />
</ContentLayout>
