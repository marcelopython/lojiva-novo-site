---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import TestimonialCard from '@/components/ui/TestimonialCard.astro';
import FaqSection from '@/components/ui/FaqSection.astro';
import BrowserFrame from '@/components/ui/BrowserFrame.astro';
import { TESTIMONIALS } from '@/data/testimonials';
import { PLANS, formatBRL, whatsappUrl } from '@/data/plans';
import { organizationSchema, websiteSchema, softwareApplicationSchema, faqSchema, jsonLdGraph } from '@/lib/schema';
import dashboardVendas from '@/assets/dashboard-vendas.png';

const features = [
  { title: 'PDV', href: '/recursos/pdv', description: 'Vendas com split de pagamento, cartão, PIX, dinheiro e fiado, e cobrança direto na maquininha.' },
  { title: 'TEF e maquininha', href: '/recursos/tef-e-maquininha', description: 'Smart TEF: cobrança de cartão e PIX enviada do PDV direto para a maquininha, sem digitar valor.' },
  { title: 'Link de pagamento', href: '/recursos/link-de-pagamento', description: 'Cobre a distância por Pix, boleto ou cartão parcelado, com página de pagamento própria.' },
  { title: 'Controle de estoque', href: '/recursos/controle-de-estoque', description: 'Saldo em tempo real, alertas de estoque baixo e transferência entre lojas ou depósitos.' },
  { title: 'Grade de cor e tamanho', href: '/recursos/grade-cor-e-tamanho', description: 'Cada combinação de cor e tamanho como um SKU próprio, com código de barras e preço individual.' },
  { title: 'Fiado e crediário', href: '/recursos/fiado-e-crediario', description: 'Limite de crédito e saldo em aberto por cliente ou representante.' },
  { title: 'Etiquetas de código de barras', href: '/recursos/etiquetas-codigo-de-barras', description: 'Configure modelo e quantidade e baixe PDF ou ZPL por produto ou variação.' },
  { title: 'Fornecedores', href: '/recursos/fornecedores', description: 'Cadastre e encontre fornecedores por nome ou CNPJ.' },
  { title: 'Controle de caixa', href: '/recursos/controle-de-caixa', description: 'Abertura, sangria, suprimento e fechamento com conferência.' },
  { title: 'Clientes', href: '/recursos/clientes', description: 'Cadastros, crédito disponível e carteira da equipe.' },
  { title: 'Logística de pedidos', href: '/recursos/logistica-de-pedidos', description: 'Etapas de embalagem, coleta e envio no mesmo painel.' },
  { title: 'Dashboard e Visão Executiva', href: '/recursos/dashboard-e-visao-executiva', description: 'Vendas, finanças e alertas de estoque em painéis gerenciais.' },
  { title: 'Extrato e saques', href: '/recursos/extrato-e-saques', description: 'Veja valores liberados, bloqueados e transferidos; administradores acompanham saques.' },
  { title: 'Anúncios Shopee e Nuvemshop', href: '/recursos/anuncios-shopee-nuvemshop', description: 'Gerencie anúncios das lojas conectadas e seus vínculos com produtos.' },
  { title: 'Lojiva Connect', href: '/recursos/lojiva-connect', description: 'Compartilhe itens e acompanhe solicitações entre lojas parceiras.' },
  { title: 'Financeiro', href: '/recursos/financeiro', description: 'Contas a pagar e a receber, fluxo de caixa e DRE para saber exatamente quanto a loja lucra.' },
  { title: 'Relatórios e DRE', href: '/recursos/relatorios-e-dre', description: 'Relatórios por área, DRE com selo de confiabilidade e Visão Executiva com os KPIs da loja.' },
  { title: 'Fiscal: NF-e e NFC-e', href: '/recursos/fiscal-nfe-nfce', description: 'Emissão de nota fiscal eletrônica e cupom fiscal direto do PDV, com certificado A1.' },
  { title: 'Trocas e devoluções', href: '/recursos/trocas-e-devolucoes', description: 'Fluxo completo de solicitação, aprovação e conclusão de trocas e devoluções.' },
  { title: 'Representantes e comissões', href: '/recursos/representantes-e-comissoes', description: 'Vendas por representação comercial com cálculo automático de comissão.' },
  { title: 'Multi-loja e compras', href: '/recursos/multi-loja', description: 'Várias lojas e depósitos, com transferência de estoque e entrada de compras por XML.' },
  { title: 'Catálogo online', href: '/recursos/catalogo-online', description: 'Vitrine digital integrada ao estoque, com pedido recebido direto no WhatsApp da loja.' },
];

const segments = [
  { title: 'Loja de roupas e moda', href: '/segmentos/loja-de-roupas-e-moda', description: 'Grade de cor e tamanho, etiquetas e giro de estoque pensados para confecção e moda.' },
  { title: 'Atacado e representantes', href: '/segmentos/atacado-e-representantes', description: 'Cadastro de representantes, comissão e vendas por atacado com condições próprias.' },
  { title: 'Varejo multicanal', href: '/segmentos/varejo-multicanal', description: 'Loja física, catálogo online e marketplaces vendendo a partir do mesmo estoque.' },
];

const integrations = [
  { title: 'Shopee', href: '/integracoes/shopee' },
  { title: 'Nuvemshop', href: '/integracoes/nuvemshop' },
  { title: 'Correios', href: '/integracoes/correios' },
];

const planPrices = PLANS.map((plan) => `${plan.nome}: ${formatBRL(plan.precoCentavos)}/mês`).join('; ');
const planLimits = PLANS.map((plan) => `${plan.nome}: ${plan.limites.usuarios} ${plan.limites.usuarios === 1 ? 'usuário' : 'usuários'}, ${plan.limites.locaisDeEstoque} ${plan.limites.locaisDeEstoque === 1 ? 'local de estoque' : 'locais de estoque'} e ${plan.limites.integracoes} ${plan.limites.integracoes === 1 ? 'integração' : 'integrações'}`).join('; ');

const faq = [
  { question: 'O que é a Lojiva?', answer: 'A Lojiva é um sistema de gestão (ERP) para lojas físicas e online. Reúne vendas, estoque e financeiro na mesma plataforma. Conheça a empresa e a proposta do produto.', href: '/sobre', linkLabel: 'Conhecer a Lojiva' },
  { question: 'Para quem a Lojiva é indicada?', answer: 'A Lojiva atende lojas físicas e online, atacado e varejo multicanal. Tem forte aderência a moda e vestuário por controlar produtos por cor e tamanho, mas também aceita itens sem variação. Veja os segmentos atendidos.', href: '/segmentos', linkLabel: 'Ver segmentos' },
  { question: 'Quais problemas a plataforma resolve?', answer: 'A plataforma reúne vendas, saldos de estoque e lançamentos financeiros para reduzir retrabalho entre controles separados. A grade permite acompanhar cada cor e tamanho individualmente, e as vendas atualizam o estoque. Veja os fluxos disponíveis.', href: '/recursos', linkLabel: 'Explorar recursos' },
  { question: 'Quais recursos estão disponíveis?', answer: 'A Lojiva reúne PDV, controle de caixa, estoque por grade, financeiro, relatórios, catálogo online, trocas e emissão fiscal. Há também integrações e módulos complementares com disponibilidade e limites próprios. Consulte o índice de recursos para os detalhes.', href: '/recursos', linkLabel: 'Ver todos os recursos' },
  { question: 'Como funciona a gestão de estoque por cor e tamanho?', answer: 'Cada combinação de cor e tamanho é uma variação com SKU, código de barras e saldo próprios. Assim, vender uma peça de um tamanho baixa o saldo daquela combinação. Produtos sem grade também podem ser cadastrados.', href: '/recursos/grade-cor-e-tamanho', linkLabel: 'Entender a grade' },
  { question: 'Como funciona o PDV?', answer: 'O operador adiciona produtos por busca, código de barras ou grade e registra a forma de pagamento. O PDV aceita divisão do valor entre formas de pagamento e baixa o estoque da variação vendida. A emissão fiscal automática depende da configuração e contratação aplicáveis.', href: '/recursos/pdv', linkLabel: 'Conhecer o PDV' },
  { question: 'A Lojiva atende atacado e varejo?', answer: 'Sim. O PDV atende vendas no balcão e o módulo de representantes organiza vendas por atacado e comissões. Há consignado e preço por quantidade para fluxos específicos, com limites por canal. Veja como esses recursos se conectam.', href: '/segmentos/atacado-e-representantes', linkLabel: 'Ver atacado e representantes' },
  { question: 'O sistema possui emissão fiscal?', answer: 'Sim. A Lojiva oferece NF-e, NFC-e e NFS-e Nacional conforme a configuração fiscal e a contratação. A NFS-e Nacional depende da adesão do município; CT-e e NFS-e municipal fora do padrão nacional não estão disponíveis. Veja os documentos e condições.', href: '/recursos/fiscal-nfe-nfce', linkLabel: 'Ver emissão fiscal' },
  { question: 'Como funciona a integração com TEF?', answer: 'O Smart TEF envia do PDV para a maquininha o valor da cobrança de cartão ou Pix, sem redigitação. Os recebíveis podem ser acompanhados no financeiro. O complemento é cobrado à parte do plano de gestão.', href: '/recursos/tef-e-maquininha', linkLabel: 'Ver Smart TEF' },
  { question: 'Quais são os planos e preços?', answer: `Os planos mensais de gestão são ${planPrices}. Há planos fiscais por volume de notas e complementos contratados à parte. Compare as funcionalidades e condições de cada plano.`, href: '/precos', linkLabel: 'Comparar planos' },
  { question: 'Quais são as limitações de cada plano?', answer: `Os limites são ${planLimits}. Fiscal, Smart TEF, Produção e Ads são complementos pagos à parte. Confira também as funcionalidades disponíveis em cada plano.`, href: '/precos', linkLabel: 'Ver limites e complementos' },
  { question: 'Como iniciar um teste ou solicitar demonstração?', answer: 'Crie uma conta pela página de cadastro para começar a testar a Lojiva. O cadastro usa verificação pelo WhatsApp. Se preferir conversar antes, use o botão de WhatsApp do site para falar com a equipe.', href: '/cadastro', linkLabel: 'Iniciar teste' },
];

const jsonLd = jsonLdGraph(organizationSchema(), websiteSchema(), softwareApplicationSchema(), faqSchema(faq));
---

<BaseLayout
  title="Lojiva | Sistema de gestão para lojas: PDV, estoque, financeiro e fiscal"
  description="A Lojiva é um sistema de gestão para lojas que reúne PDV, controle de estoque com grade de cor e tamanho, financeiro, fiscal (NF-e/NFC-e) e vendas em uma única plataforma."
  image={dashboardVendas.src}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="overflow-hidden border-b border-border bg-gradient-to-b from-accent/60 to-background py-16 sm:py-24">
    <div class="container-page grid items-center gap-12 lg:grid-cols-2">
      <div>
        <span class="inline-flex items-center rounded-full bg-white px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary shadow-soft">
          Sistema de gestão para lojas
        </span>
        <h1 class="mt-5 font-display text-4xl font-bold leading-[1.1] tracking-tight text-foreground sm:text-5xl">
          Uma única plataforma para vender, controlar estoque e cuidar do financeiro da sua loja
        </h1>
        <p class="mt-5 max-w-xl text-lg text-muted-foreground">
          A Lojiva reúne PDV, controle de estoque por grade de cor e tamanho, financeiro, emissão fiscal e vendas por representantes em um só sistema — para lojas físicas, atacado e varejo multicanal.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/cadastro" size="lg" id="hero-cta-primary">Testar a Lojiva</Button>
          <Button href={whatsappUrl('Olá! Gostaria de ver como a Lojiva funciona.')} variant="outline" size="lg" external id="hero-cta-whatsapp">
            Falar com especialista
          </Button>
        </div>
        <p class="mt-4 text-sm text-muted-foreground">Cadastro em poucos minutos, com verificação por WhatsApp.</p>
      </div>
      <BrowserFrame src={dashboardVendas} alt="Tela de vendas da Lojiva com a lista de pedidos, totais e filtro por canal de venda" priority />
    </div>
  </section>

  <!-- Trust bar -->
  <section class="border-b border-border py-10">
    <div class="container-page">
      <p class="text-center text-xs font-semibold uppercase tracking-wider text-muted-foreground">Usada por lojas de moda e varejo em todo o Brasil</p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-12 gap-y-4 opacity-80">
        {TESTIMONIALS.map((t) => (
          <span class="text-sm font-semibold text-foreground/70">{t.author}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20">
    <div class="container-page">
      <SectionHeading
        eyebrow="Funcionalidades"
        title="Tudo que a operação de uma loja precisa, em um só lugar"
        description="Da venda no balcão ao fechamento do mês: PDV, estoque, financeiro e fiscal conectados, sem planilha paralela."
      />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {features.map((f) => (
          <Card href={f.href} class="h-full">
            <h3 class="font-display text-base font-bold text-foreground">{f.title}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{f.description}</p>
          </Card>
        ))}
      </div>
      <div class="mt-8 text-center">
        <Button href="/recursos" variant="ghost">Ver todos os recursos →</Button>
      </div>
    </div>
  </section>

  <!-- Segments -->
  <section class="border-t border-border bg-muted/40 py-20">
    <div class="container-page">
      <SectionHeading
        eyebrow="Segmentos"
        title="Feita para o dia a dia de quem vende de verdade"
        description="A Lojiva se adapta à forma como o seu negócio vende — no balcão, no atacado ou nos marketplaces."
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-3">
        {segments.map((s) => (
          <Card href={s.href} class="h-full">
            <h3 class="font-display text-lg font-bold text-foreground">{s.title}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{s.description}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Integrations -->
  <section class="py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Integrações" title="Conectada com quem sua loja já usa" />
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        {integrations.map((i) => (
          <a href={i.href} class="rounded-full border border-border bg-card px-5 py-2.5 text-sm font-medium text-foreground shadow-soft hover:border-primary hover:text-primary">
            {i.title}
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <Button href="/integracoes" variant="ghost">Ver todas as integrações →</Button>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section id="depoimentos" class="border-t border-border bg-muted/40 py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Depoimentos" title="O que os lojistas dizem" />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {TESTIMONIALS.map((t) => <TestimonialCard {...t} />)}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16">
    <div class="container-page mx-auto max-w-3xl">
      <FaqSection items={faq} title="Perguntas frequentes sobre a Lojiva" />
      <div class="mt-8 text-center">
        <Button href="/perguntas" variant="ghost">Ver mais dúvidas: é confiável? vale a pena? limitações? →</Button>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="border-t border-border bg-surface-dark py-16">
    <div class="container-page text-center">
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">Pronto para organizar a gestão da sua loja?</h2>
      <p class="mx-auto mt-4 max-w-xl text-white/60">Comece a testar a Lojiva agora ou fale com um especialista antes de decidir.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/cadastro" size="lg">Testar a Lojiva</Button>
        <Button href={whatsappUrl('Olá! Gostaria de ver como a Lojiva funciona.')} variant="outline" size="lg" external class="!border-white/20 !bg-transparent !text-white hover:!bg-white/10">
          Falar com especialista
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
